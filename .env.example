# docker compose reads this file as .env (copy it: cp .env.example .env)
MYSQL_DATABASE=prosparity
MYSQL_USER=prosparity
MYSQL_PASSWORD=prosparity
MYSQL_ROOT_PASSWORD=rootpass
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=60
BUSINESS_TIMEZONE=Asia/Kolkata
SEED_DEMO=true
WEB_PORT=8080
API_PORT=8000
MYSQL_PORT=3306
