# Copy to backend/.env for local (non-Docker) development
ENVIRONMENT=development
# MySQL 8 (production / docker):
DATABASE_URL=mysql+pymysql://prosparity:prosparity@localhost:3306/prosparity?charset=utf8mb4
# or quick local dev without MySQL:
# DATABASE_URL=sqlite:///./storage/dev.db
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
BUSINESS_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_URL=http://localhost:5173
ENABLE_SCHEDULER=true

# Collection Dashboard attendance sync — defaults live in app/core/config.py
# COLLECTION_API_BASE_URL=https://collection.prosparity.in
# COLLECTION_API_KEY=
# First day to pull Collection marks (pre-fill through today; daily sync covers onward)
# COLLECTION_SYNC_START_DATE=2026-11-19

# --- hosted deployment (Render + TiDB Cloud) – see DEPLOY.md ---
# ENVIRONMENT=production            # also enforces a real JWT_SECRET (>= 32 chars)
# DATABASE_URL=mysql+pymysql://<user>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/prosparity?charset=utf8mb4
# DB_SSL=true                       # TLS to the database (public CA bundle; DB_SSL_CA=/path/ca.pem for a custom CA)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# CORS_ORIGINS=https://prosparity.vercel.app
# CORS_ORIGIN_REGEX=https://prosparity-[a-z0-9-]+\.vercel\.app   # optional: Vercel preview URLs
